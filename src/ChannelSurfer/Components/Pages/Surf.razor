@page "/"
@rendermode InteractiveServer
@inject ContentService Content
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>Channel Surfer</PageTitle>

<div class="surf" tabindex="0" @ref="_root" @onkeydown="OnKeyDown" @onkeydown:preventDefault="true" @onclick="ToggleControls">
    @if (_channels.Count == 0)
    {
        <div class="noch glow">
            NO CHANNELS
            <span>Set your playlist in <a href="/settings">Settings</a></span>
        </div>
    }
    else
    {
        <video class="tv-video" @ref="_video" autoplay playsinline></video>
        @if (_error is not null)
        {
            <div class="stream-error glow">⚠ @_error</div>
        }
        <Banner Channel="Cur" Now="_now" Next="_next" Progress="_progress" Visible="_bannerVisible" />
        <div class="guide-hint" @ref="_hint">Press <b>G</b> for Guide</div>
        @if (_entry.Length > 0)
        {
            <div class="entry glow">@_entry</div>
        }

        @* Touch controls — shown only on coarse-pointer (touch) devices via CSS. *@
        <div class="touch-controls @(_controlsVisible ? "show" : "")">
            <button class="touch-btn" @onclick="() => TouchFlip(1)" @onclick:stopPropagation="true" aria-label="Channel up">▲</button>
            <button class="touch-btn" @onclick="() => TouchFlip(-1)" @onclick:stopPropagation="true" aria-label="Channel down">▼</button>
            <button class="touch-btn wide" @onclick="OpenGuide" @onclick:stopPropagation="true">Guide</button>
            <button class="touch-btn" @onclick="ToggleFullscreen" @onclick:stopPropagation="true" aria-label="Fullscreen">⛶</button>
        </div>
    }
</div>

@code {
    private ElementReference _root;
    private ElementReference _video;
    private ElementReference _hint;
    private DotNetObjectReference<Surf>? _ref;
    private IReadOnlyList<Channel> _channels = Array.Empty<Channel>();
    private int _index;
    private Programme? _now, _next;
    private double _progress;
    private bool _bannerVisible;
    private string? _error;
    private string _entry = "";
    private System.Timers.Timer? _bannerTimer;
    private System.Timers.Timer? _controlsTimer;
    private bool _controlsVisible = true; // shown on load (touch), then auto-hides
    private bool _isIos;

    private Channel? Cur => _channels.Count > 0 ? _channels[_index] : null;

    protected override void OnInitialized()
    {
        _channels = Content.Current.Channels;

        // Guide's Enter-to-tune arrives as /?ch=<number>.
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (query.TryGetValue("ch", out var chv) && int.TryParse(chv, out var chNumber))
        {
            for (var i = 0; i < _channels.Count; i++)
            {
                if (_channels[i].Number == chNumber) { _index = i; break; }
            }
        }

        _ref = DotNetObjectReference.Create(this);
        _bannerTimer = new System.Timers.Timer(5000) { AutoReset = false };
        _bannerTimer.Elapsed += (_, _) => InvokeAsync(() =>
        {
            _bannerVisible = false;
            StateHasChanged();
        });
        _controlsTimer = new System.Timers.Timer(4000) { AutoReset = false };
        _controlsTimer.Elapsed += (_, _) => InvokeAsync(() =>
        {
            _controlsVisible = false;
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _channels.Count > 0)
        {
            _isIos = await JS.InvokeAsync<bool>("hlsInterop.isIos");
            // On iOS, open straight to a playable (HLS) channel if we'd start on an MPEG-TS one.
            if (_isIos && _channels[_index].IsMpegTs)
                _index = ChannelNav.NextPlayableIndex(_channels, _index, +1, restrictToHls: true);
            await TuneAsync();
            await _root.FocusAsync();
            await JS.InvokeVoidAsync("hlsInterop.guideHint", _root, _hint);
            RestartControlsTimer(); // auto-hide the initially-shown touch controls
        }
    }

    private async Task TuneAsync()
    {
        _error = null;
        ComputeNowNext();
        ShowBanner();

        var kind = Cur!.IsMpegTs ? "ts" : "hls";

        // iPhone/iPad can't play MPEG-TS — point the viewer at the HLS browser-only channels.
        if (_isIos && kind == "ts")
        {
            await JS.InvokeVoidAsync("hlsInterop.destroy", _video);
            _error = "This channel doesn't play on iPhone. Switch to a Browser-Only channel (100+).";
            StateHasChanged();
            return;
        }

        var url = "/proxy/stream?u=" + Uri.EscapeDataString(Cur.StreamUrl);
        await JS.InvokeVoidAsync("hlsInterop.attach", _video, url, kind, _ref);
        StateHasChanged();
    }

    private void ComputeNowNext()
    {
        (_now, _next) = Content.Current.NowNext(Cur!, DateTimeOffset.Now);
        _progress = _now is not null ? Lineup.Progress(_now, DateTimeOffset.Now) : 0;
    }

    private void ShowBanner()
    {
        _bannerVisible = true;
        _bannerTimer!.Stop();
        _bannerTimer.Start();
    }

    private async Task Flip(int delta)
    {
        // On iOS, skip MPEG-TS channels (unplayable there).
        _index = ChannelNav.NextPlayableIndex(_channels, _index, delta, _isIos);
        await TuneAsync();
    }

    // --- Touch controls ---
    private void ToggleControls()
    {
        _controlsVisible = !_controlsVisible;
        if (_controlsVisible) RestartControlsTimer();
    }

    private void RestartControlsTimer()
    {
        _controlsTimer!.Stop();
        _controlsTimer.Start();
    }

    private async Task TouchFlip(int delta)
    {
        RestartControlsTimer();
        await Flip(delta);
    }

    private void OpenGuide() => Nav.NavigateTo("/guide");

    private async Task ToggleFullscreen()
    {
        RestartControlsTimer();
        await JS.InvokeVoidAsync("hlsInterop.fullscreen", _video);
    }

    private async Task TuneToNumber(int number)
    {
        for (var i = 0; i < _channels.Count; i++)
        {
            if (_channels[i].Number == number)
            {
                _index = i;
                await TuneAsync();
                return;
            }
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "+":
            case "ArrowUp":
            case "PageUp":
                await Flip(1);
                break;
            case "-":
            case "ArrowDown":
            case "PageDown":
                await Flip(-1);
                break;
            case "g":
            case "G":
                Nav.NavigateTo("/guide");
                break;
            case "f":
            case "F":
                await JS.InvokeVoidAsync("hlsInterop.fullscreen", _video);
                break;
            case "Escape":
                _bannerVisible = false;
                _entry = "";
                break;
            case "Enter":
                if (_entry.Length > 0 && int.TryParse(_entry, out var n))
                {
                    _entry = "";
                    await TuneToNumber(n);
                }
                break;
            default:
                if (e.Key.Length == 1 && char.IsDigit(e.Key[0]))
                {
                    _entry += e.Key;
                }
                break;
        }
    }

    [JSInvokable]
    public Task OnStreamError(string details)
    {
        _error = $"Can't play this channel ({details})";
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _bannerTimer?.Dispose();
        _controlsTimer?.Dispose();
        // Stop hls.js downloading segments after we leave the surf view.
        try { await JS.InvokeVoidAsync("hlsInterop.destroy", _video); }
        catch { /* circuit already gone */ }
        _ref?.Dispose();
    }
}
